<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShadowBug.MainPage">
			 
    <ScrollView>
        <VerticalStackLayout 
            Spacing="25" 
            Padding="30,0" 
            VerticalOptions="Center">

            <Border Stroke="Black"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 10">
                <Border.Shadow>
                    <Shadow Offset="5,5"
                            Opacity="0.8"
                            Brush="Black"
                            Radius="20"/>
                </Border.Shadow>
                <Label Text="Test 1"
                       Margin="10"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
 
</ContentPage>
